{
  "name": "scratch-l10n",
  "version": "3.1001.0",
  "description": "Minified scratch-l10n for NitroBolt",
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/l10n.js",
  "browser": "./src/index.js",
  "bin": {
    "build-i18n-src": "./scripts/build-i18n-src.js",
    "tx-push-src": "./scripts/tx-push-src.js"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:data && webpack --progress --colors --bail",
    "build:data": "babel-node scripts/build-data",
    "clean": "rimraf ./dist ./locales && mkdirp dist locales",
    "lint": "pnpm run lint:js && pnpm run lint:json",
    "lint:js": "eslint . --ext .js",
    "lint:json": "jshint -e .json www editor/blocks editor/extensions editor/interface editor/paint-editor sources",
    "prepare": "pnpm run build",
    "sources:collect": "node scripts/collect-sources.js",
    "sync:upstream": "node scripts/sync-upstream.js",
    "transifex:pull": "pnpm run transifex:pull:blocks && pnpm run transifex:pull:extensions && pnpm run transifex:pull:paint && pnpm run transifex:pull:interface",
    "transifex:pull:blocks": "babel-node scripts/tx-pull-editor nitrobolt blocks ./overrides/editor/blocks/",
    "transifex:pull:extensions": "babel-node scripts/tx-pull-editor nitrobolt extensions ./overrides/editor/extensions/",
    "transifex:pull:interface": "babel-node scripts/tx-pull-editor nitrobolt interface ./overrides/editor/interface/",
    "transifex:pull:paint": "babel-node scripts/tx-pull-editor nitrobolt paint-editor ./overrides/editor/paint-editor/",
    "transifex:push": "pnpm run sources:collect && pnpm run transifex:push:blocks && pnpm run transifex:push:extensions && pnpm run transifex:push:paint && pnpm run transifex:push:interface",
    "transifex:push:blocks": "tx-push-src nitrobolt blocks ./sources/blocks.json",
    "transifex:push:extensions": "tx-push-src nitrobolt extensions ./sources/extensions.json",
    "transifex:push:interface": "tx-push-src nitrobolt interface ./sources/interface.json",
    "transifex:push:paint": "tx-push-src nitrobolt paint-editor ./sources/paint-editor.json",
    "test": "pnpm run lint:js && pnpm run validate:editor && pnpm run validate:www && pnpm run build && pnpm run lint:json",
    "validate:blocks": "babel-node scripts/validate-translations ./editor/blocks/",
    "validate:editor": "pnpm run validate:blocks && pnpm run validate:extensions && pnpm run validate:interface && pnpm run validate:paint",
    "validate:extensions": "babel-node scripts/validate-translations ./editor/extensions/ && babel-node scripts/validate-extension-inputs",
    "validate:interface": "babel-node scripts/validate-translations ./editor/interface/",
    "validate:paint": "babel-node scripts/validate-translations ./editor/paint-editor/",
    "validate:www": "babel-node scripts/validate-www ./www"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nitro-Bolt/scratch-l10n.git"
  },
  "author": "Cubester",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Nitro-Bolt/scratch-l10n/issues"
  },
  "homepage": "https://github.com/Nitro-Bolt/scratch-l10n#readme",
  "dependencies": {
    "@babel/cli": "^7.1.2",
    "@babel/core": "^7.1.2",
    "@transifex/api": "4.3.0",
    "babel-plugin-react-intl": "^3.0.1",
    "download": "^8.0.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.18.2",
    "@babel/node": "7.22.19",
    "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
    "@babel/plugin-syntax-dynamic-import": "^7.0.0",
    "@babel/plugin-transform-async-to-generator": "^7.1.0",
    "@babel/preset-env": "^7.9.5",
    "@babel/preset-react": "^7.0.0",
    "async": "3.2.5",
    "babel-eslint": "^10.0.1",
    "babel-loader": "8.3.0",
    "eslint": "8.17.0",
    "eslint-config-scratch": "9.0.3",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-react": "^7.5.1",
    "format-message-parse": "6.2.4",
    "glob": "7.2.3",
    "jshint": "2.13.6",
    "lodash.defaultsdeep": "4.6.1",
    "mkdirp": "^0.5.1",
    "node-fetch": "^2.6.0",
    "p-limit": "2.3.0",
    "p-queue": "3.2.0",
    "rimraf": "^2.6.2",
    "webpack": "^4.6.0",
    "webpack-cli": "^3.1.2"
  }
}
